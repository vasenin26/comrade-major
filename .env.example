# Скопируйте в .env и измените под своё окружение:
# cp .env.example .env

# --- Аудио ---
SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=500

# --- STT (faster-whisper) ---
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small

# --- TTS (Silero v5_ru, torch.hub) ---
# aidar | baya | kseniya | xenia | eugene
TTS_SPEAKER=aidar
TTS_DEVICE=auto
# 8000 | 24000 | 48000 — resampled to SAMPLE_RATE for playback
TTS_SYNTHESIS_SAMPLE_RATE=24000
# Half-duplex: keep mic muted this long after TTS ends (echo hangover)
TTS_LISTEN_HANGOVER_MS=400

# --- Primary mind ---
# local  — HuggingFace transformers в процессе
# openai — OpenAI-compatible HTTP API
PRIMARY_MIND_PROVIDER=local
PRIMARY_MIND_MODEL=Qwen/Qwen2.5-3B-Instruct
PRIMARY_MIND_DEVICE=auto
PRIMARY_MIND_MAX_NEW_TOKENS=256
PRIMARY_MIND_TEMPERATURE=0.7
# По умолчанию: Товарищ Майор (личность); `say` = отправить пользователю;
# приватные мысли → [THOUGHTS], не в chat. Думает по пульсу / user / INNER.
# PRIMARY_MIND_SYSTEM_PROMPT=...
PRIMARY_THINK_PULSE_SECONDS=15
PRIMARY_THOUGHT_HISTORY=8

# Только для PRIMARY_MIND_PROVIDER=openai
# PRIMARY_MIND_API_KEY=sk-your-key-here
# PRIMARY_MIND_BASE_URL=https://api.openai.com/v1
# Примеры base_url:
# DeepSeek: https://api.deepseek.com/v1
# Groq:     https://api.groq.com/openai/v1

# --- Inner voice (optional overrides; defaults to primary profile) ---
# Пример: OpenAI gpt-5-mini (primary может оставаться local)
INNER_VOICE_PROVIDER=openai
INNER_VOICE_MODEL=gpt-5-mini
INNER_VOICE_MAX_NEW_TOKENS=128
INNER_VOICE_API_KEY=sk-your-key-here
# INNER_VOICE_BASE_URL=https://api.openai.com/v1
# INNER_VOICE_REASONING_EFFORT=minimal
# HTTP(S) proxy for OpenAI-compatible calls
# INNER_VOICE_PROXY=http://127.0.0.1:7890
# PRIMARY_MIND_PROXY=http://user:pass@host:8080
# INNER_VOICE_SYSTEM_PROMPT=...
INNER_VOICE_INTERVAL_SECONDS=60
# Локальный inner (если не нужен OpenAI):
# INNER_VOICE_PROVIDER=local
# INNER_VOICE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# INNER_VOICE_DEVICE=auto
# INNER_VOICE_TEMPERATURE=0.5

MIND_CONTEXT_TRIM_COUNT=2

# Legacy aliases still accepted: LLM_PROVIDER, LLM_MODEL, LLM_API_KEY, ...

# --- Прочее ---
LOG_DIR=logs

# --- Web monitor (браузер: http://127.0.0.1:8765) ---
UI_HOST=127.0.0.1
UI_PORT=8765
